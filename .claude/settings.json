{
  "permissions": {
    "defaultMode": "plan",
    "useAutoModeDuringPlan": false,
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Write(**)",

      "Bash(cat*)",
      "Bash(grep*)",
      "Bash(tail*)",
      "Bash(head*)",
      "Bash(wc*)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(sha256sum*)",

      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git ls-remote*)",
      "Bash(git ls-tree*)",
      "Bash(git merge-base*)",
      "Bash(git rev-parse*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(git checkout agent/*)",
      "Bash(git checkout main)",
      "Bash(git checkout -b agent/*)",
      "Bash(git branch agent/*)",
      "Bash(git branch -d *)",
      "Bash(git push origin agent/*)",
      "Bash(git push -u origin agent/*)",

      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",

      "Bash(python3 -m py_compile*)",
      "Bash(python3 -m unittest*)",
      "Bash(python -m unittest*)",
      "Bash(python3 -m capage.longitudinal experiments/sandbox/longitudinal_manifest_v2.json --checkpoint /tmp/capage-checkpoint.json --artifact-dir /tmp/capage-months --memory /tmp/capage-memory.sqlite3 --validate-only)",
      "Bash(python3 -m capage.longitudinal_v3 experiments/sandbox/longitudinal_manifest_v3.json --checkpoint /tmp/capage-v3-checkpoint.json --artifact-dir /tmp/capage-v3-months --memory /tmp/capage-v3-memory.sqlite3 --validate-only)",
      "Bash(python3 -m capage.transfer experiments/sandbox/transfer_manifest_v1.json --validate-only)",
      "Bash(python3 -m capage.homeostasis_v2_replication_launch --validate-only)",

      "Bash(rm -rf /root/CapAge/.agent-scratch/*)",
      "Bash(rm -rf */__pycache__)",
      "Bash(rm -rf */.pytest_cache)",
      "Bash(find * -name __pycache__ -exec rm -rf {} +)",

      "Bash(termux-clipboard-set*)",
      "Bash(termux-clipboard-get*)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(git push *)",
      "Bash(git branch -D *)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/secrets/**)",

      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(AGENTS.md)",
      "Write(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(**/*AUTHORIZATION*.md)",
      "Write(**/*AUTHORIZATION*.md)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(capage/policy.py)",
      "Write(capage/policy.py)",
      "Edit(capage/executor.py)",
      "Write(capage/executor.py)",
      "Edit(capage/audit.py)",
      "Write(capage/audit.py)",

      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git clean*)",
      "Bash(git push*main*)",
      "Bash(git push*--force*)",
      "Bash(git push*-f *)",
      "Bash(git push*--delete*)",
      "Bash(git push*homeostasis-v2-blocked-replication-launch*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git revert*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr edit*)",
      "Bash(gh api*-X PATCH*)",
      "Bash(gh api*-X DELETE*)",
      "Bash(gh api*-X PUT*)",
      "Bash(gh workflow run*)",
      "Bash(gh run rerun*)"
    ]
  }
}
