{
  "permissions": {
    "defaultMode": "plan",
    "ask": [
      "Edit(/.github/workflows/**)",
      "Edit(/experiments/sandbox/*AUTHORIZATION*.md)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/secrets/**)"
    ]
  }
}
